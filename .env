# Server
PORT=8080
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/smartwaste

# Redis (BullMQ)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Evidence Storage (MinIO / S3)
#S3_ENDPOINT=http://minio:9000
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=swm-evidence
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Google Maps (Distance Matrix)
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_USE_DISTANCE_MATRIX=true
GOOGLE_MAPS_USE_DIRECTIONS_OPTIMIZATION=true

# # Payments
# PAYMENT_PROVIDER=MOCK
# PAYMENT_MOCK_BASE_URL=http://localhost:8080

# # Khalti (fill when ready)
# KHALTI_PUBLIC_KEY=
# KHALTI_SECRET_KEY=
# # Endpoint may differ based on Khalti product used
# KHALTI_INITIATE_URL=https://a.khalti.com/api/v2/epayment/initiate/

# =========================
# APP CONFIG
# =========================
NODE_ENV=development
PORT=5000
BASE_URL=https://dev.khalti.com/api/v2
WEBSITE_URL=http://localhost:3000

# =========================
# PAYMENT PROVIDER
# =========================
PAYMENT_PROVIDER=KHALTI

# =========================
# KHALTI CONFIG
# =========================
KHALTI_ENV=sandbox
KHALTI_SECRET_KEY=af4288989bb94c4bbee8752372614b00
KHALTI_PUBLIC_KEY=24656be2b6c542cdbec4a945a0c6756e



# =========================
# MOCK PAYMENT (OPTIONAL)
# =========================
MOCK_PAYMENT_BASE_URL=http://localhost:5000


# Digital Twin (Virtual Bin thresholds)
VIRTUAL_BIN_OVER80_THRESHOLD=0.35
VIRTUAL_BIN_OVER95_THRESHOLD=0.10
VIRTUAL_BIN_RISK_THRESHOLD=70

# Routing
SCOOTER_BUFFER_PERCENT=0.25

# Billing
BULKY_DAILY_CHARGE=50
INVOICE_DAY_OF_MONTH=1

# Background Jobs
SCHEDULER_ENABLED=true
SCHEDULER_USER_ID=
# If blank, worker will auto-pick the first admin user it finds

DAILY_ROUTES_CRON=0 6 * * *
# Overrides invoice cron if you want (optional)
# MONTHLY_INVOICES_CRON=0 1 1 * *

# AI service
AI_BASE_URL=http://ai:8001

# Optional IoT ingest shared key (if set, devices must send header x-iot-key)
# IOT_INGEST_KEY=change_me
