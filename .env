# =========================
# SERVER
# =========================
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Public URLs (used for payment callbacks/redirects)
WEBSITE_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:5000

# =========================
# MongoDB
# =========================
MONGO_URI=mongodb://127.0.0.1:27017/smartwaste

# =========================
# Redis (BullMQ)
# =========================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# =========================
# JWT
# =========================
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =========================
# Evidence Storage (MinIO / S3)
# =========================
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=swm-evidence
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# =========================
# Google Maps (Distance Matrix / Directions)
# =========================
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_USE_DISTANCE_MATRIX=true
GOOGLE_MAPS_USE_DIRECTIONS_OPTIMIZATION=true

# =========================
# PAYMENT PROVIDER
# =========================
# Options: ESEWA | MOCK
PAYMENT_PROVIDER=ESEWA

# =========================
# ESEWA CONFIG (ePay v2) - SANDBOX/UAT
# =========================
ESEWA_ENV=sandbox
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/

# =========================
# MOCK PAYMENT (OPTIONAL)
# =========================
MOCK_PAYMENT_BASE_URL=http://localhost:5000

# =========================
# Digital Twin (Virtual Bin thresholds)
# =========================
VIRTUAL_BIN_OVER80_THRESHOLD=0.35
VIRTUAL_BIN_OVER95_THRESHOLD=0.10
VIRTUAL_BIN_RISK_THRESHOLD=70

# =========================
# Routing
# =========================
SCOOTER_BUFFER_PERCENT=0.25

# =========================
# Billing
# =========================
BULKY_DAILY_CHARGE=50
INVOICE_DAY_OF_MONTH=1

# =========================
# Background Jobs
# =========================
SCHEDULER_ENABLED=true
SCHEDULER_USER_ID=
DAILY_ROUTES_CRON=0 6 * * *
# MONTHLY_INVOICES_CRON=0 1 1 * *

# =========================
# AI service
# =========================
AI_BASE_URL=http://ai:8001

